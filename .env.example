# Vercel 프로젝트의 Environment Variables 에 아래 값들을 등록하세요.
# (이 파일 자체는 배포에 쓰이지 않습니다. 그냥 어떤 값이 필요한지 알려주는 예시입니다.)

# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Upstash Redis (팀 리더보드 공유 저장용, https://upstash.com 무료 티어)
# Vercel 대시보드 > Storage 탭 > Upstash Redis 추가하면 자동으로 채워집니다.
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxx
